#!/usr/bin/env python3
"""
GU605MY Slash LED Animation Player
Plays .slashlighting files on the ASUS Slash LED (0B05:193B)

Uses the reverse-engineered rog-slash protocol:
  Report ID: 0x5e (for GU605_2024 → 0x193b)
  Init:     0xd7, 0xd2
  Enable:   0xd8
  Mode:     0xd2 + 0xd3
  Options:  0xd3 (brightness, interval)

Since per-segment control is not yet reverse-engineered, this player
approximates animations by mapping average frame brightness to global
brightness while in Static mode.
"""

import hid
import time
import sys
import glob
from pathlib import Path

SLASH_VID = 0x0B05
SLASH_PID = 0x193B
REPORT_ID = 0x5e
PACKET_SIZE = 32


def make_packet(payload: bytes) -> bytes:
    return payload.ljust(PACKET_SIZE, b'\x00')[:PACKET_SIZE]


def send_packet(device, payload: bytes):
    try:
        device.send_feature_report(make_packet(payload))
    except Exception as e:
        print(f"Send error: {e}")


def slash_init(device):
    """Initialize slash device after boot."""
    pkt1 = bytes([REPORT_ID, 0xd7, 0x00, 0x00, 0x01, 0xac])
    pkt2 = bytes([REPORT_ID, 0xd2, 0x02, 0x01, 0x08, 0xab])
    send_packet(device, pkt1)
    send_packet(device, pkt2)


def slash_enable(device, enabled: bool):
    pkt = bytes([REPORT_ID, 0xd8, 0x02, 0x00, 0x01, 0x00 if enabled else 0x80])
    send_packet(device, pkt)


def slash_set_mode(device, mode: int):
    """Set slash mode. Known modes from rog-slash:
    Static=0x06, Bounce=0x10, Slash=0x12, Loading=0x13,
    Flow=0x19, BitStream=0x1d, Transmission=0x1a,
    Flux=0x25, Phantom=0x24, Spectrum=0x26,
    Hazard=0x32, Interfacing=0x33, Ramp=0x34,
    GameOver=0x42, Start=0x43, Buzzer=0x44
    """
    pkt1 = bytes([REPORT_ID, 0xd2, 0x03, 0x00, 0x0c])
    pkt2 = bytes([REPORT_ID, 0xd3, 0x04, 0x00, 0x0c, 0x01, mode, 0x02, 0x19,
                  0x03, 0x13, 0x04, 0x11, 0x05, 0x12, 0x06, 0x13])
    send_packet(device, pkt1)
    send_packet(device, pkt2)


def slash_set_options(device, brightness: int, interval: int = 0):
    pkt = bytes([REPORT_ID, 0xd3, 0x03, 0x01, 0x08, 0xab, 0xff, 0x01, 0x01,
                 0x06, brightness, 0xff, interval])
    send_packet(device, pkt)


def parse_slashlighting(filepath):
    config = {"frames": [], "name": "", "frame_count": 0}
    current_section = None
    with open(filepath, 'r') as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith(';'):
                continue
            if line.startswith('[') and line.endswith(']'):
                current_section = line[1:-1].upper()
                continue
            if '=' in line:
                key, val = line.split('=', 1)
                key = key.strip()
                val = val.strip()
                if current_section == "EFFECT NAME":
                    config["name"] = val
                elif current_section == "CONFIG":
                    if key == "FrameCount":
                        config["frame_count"] = int(val)
                elif current_section == "FRAMES":
                    brightnesses = [int(v) for v in val.rstrip(',').split(',')]
                    config["frames"].append(brightnesses)
    return config


def find_slash_device():
    devices = hid.enumerate(SLASH_VID, SLASH_PID)
    for d in devices:
        return d
    return None


def play_animation(device, frames, fps=15):
    """Play animation by modulating brightness in Static mode."""
    slash_set_mode(device, 0x06)  # Static mode
    delay = 1.0 / fps
    print(f"Playing {len(frames)} frames at {fps} FPS")
    try:
        for frame in frames:
            if len(frame) >= 7:
                avg = sum(frame[:7]) // 7
            else:
                avg = sum(frame) // len(frame) if frame else 0
            slash_set_options(device, avg)
            time.sleep(delay)
    except KeyboardInterrupt:
        pass


def list_presets(directory):
    pattern = str(Path(directory) / "**" / "*.slashlighting")
    files = glob.glob(pattern, recursive=True)
    presets = {}
    for f in files:
        p = Path(f)
        presets[p.stem] = f
    return presets


def main():
    import argparse
    parser = argparse.ArgumentParser(description="GU605MY Slash LED Player")
    parser.add_argument("file", nargs="?", help=".slashlighting file to play")
    parser.add_argument("--mode", help="Set preset mode (Static, Spectrum, Flow, Phantom, etc.)")
    parser.add_argument("--brightness", type=int, default=128, help="Global brightness 0-255")
    parser.add_argument("--off", action="store_true", help="Turn off slash LED")
    parser.add_argument("--on", action="store_true", help="Turn on slash LED")
    parser.add_argument("--list-presets", metavar="DIR", help="List available .slashlighting presets")
    parser.add_argument("--fps", type=int, default=15, help="Animation FPS")
    parser.add_argument("--loop", action="store_true", help="Loop animation forever")
    args = parser.parse_args()

    if args.list_presets:
        presets = list_presets(args.list_presets)
        for name, path in sorted(presets.items()):
            print(f"  {name}: {path}")
        return

    dev_info = find_slash_device()
    if not dev_info:
        print("Error: Slash LED device (0B05:193B) not found")
        sys.exit(1)

    device = hid.device()
    device.open_path(dev_info['path'])

    try:
        slash_init(device)

        if args.off:
            slash_enable(device, False)
            print("Slash LED disabled")
        elif args.on:
            slash_enable(device, True)
            slash_set_options(device, args.brightness)
            print("Slash LED enabled")
        elif args.mode:
            mode_map = {
                "Static": 0x06, "Bounce": 0x10, "Slash": 0x12, "Loading": 0x13,
                "Flow": 0x19, "BitStream": 0x1d, "Transmission": 0x1a,
                "Flux": 0x25, "Phantom": 0x24, "Spectrum": 0x26,
                "Hazard": 0x32, "Interfacing": 0x33, "Ramp": 0x34,
                "GameOver": 0x42, "Start": 0x43, "Buzzer": 0x44,
            }
            mode_val = mode_map.get(args.mode, 0x06)
            slash_enable(device, True)
            slash_set_mode(device, mode_val)
            slash_set_options(device, args.brightness)
            print(f"Set mode: {args.mode} (0x{mode_val:02x})")
        elif args.file:
            config = parse_slashlighting(args.file)
            print(f"Loading: {config['name']} ({len(config['frames'])} frames)")
            slash_enable(device, True)
            play_animation(device, config['frames'], args.fps)
        else:
            parser.print_help()
    finally:
        device.close()


if __name__ == "__main__":
    main()

# Also update the play_animation function to support looping
def play_animation_loop(device, frames, fps=15):
    """Play animation in a loop until interrupted."""
    slash_set_mode(device, 0x06)  # Static mode
    delay = 1.0 / fps
    print(f"Looping {len(frames)} frames at {fps} FPS (Ctrl+C to stop)")
    try:
        while True:
            for frame in frames:
                if len(frame) >= 7:
                    avg = sum(frame[:7]) // 7
                else:
                    avg = sum(frame) // len(frame) if frame else 0
                slash_set_options(device, avg)
                time.sleep(delay)
    except KeyboardInterrupt:
        pass
