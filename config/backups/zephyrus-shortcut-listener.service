[Unit]
Description=Zephyrus Shortcut Listener (Screenshots + FN Keys + LED)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/zephyrus-shortcut-listener.py
Restart=on-failure
RestartSec=3
StartLimitInterval=60
StartLimitBurst=10

[Install]
WantedBy=default.target
